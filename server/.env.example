# Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration (Gemini 2.5 models with 1M token context)
ANALYZER_MODEL=gemini-2.5-flash
PREDICTOR_MODEL=gemini-2.5-flash
SUGGESTION_MODEL=gemini-2.5-pro
ACTION_MODEL=gemini-2.5-flash
SUPERVISOR_MODEL=gemini-2.5-pro

# Model Parameters
TEMPERATURE=0.7
MAX_TOKENS=8192

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (use * for all origins, or comma-separated list)
ALLOWED_ORIGINS=*

# Batch Processing
BATCH_SIZE=50
ANALYSIS_THRESHOLD=20

# Logging
LOG_LEVEL=INFO
