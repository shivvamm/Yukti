# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
ANALYZER_MODEL=llama-3.1-8b-instant
PREDICTOR_MODEL=llama-3.1-8b-instant
SUGGESTION_MODEL=llama-3.1-70b-versatile
ACTION_MODEL=llama-3.1-70b-versatile
SUPERVISOR_MODEL=llama-3.1-70b-versatile

# Model Parameters
TEMPERATURE=0.7
MAX_TOKENS=1024

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:8000

# Batch Processing
BATCH_SIZE=50
ANALYSIS_THRESHOLD=20

# Logging
LOG_LEVEL=INFO
